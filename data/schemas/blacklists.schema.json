{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["userId", "reason", "timestamp"],
    "properties": {
      "userId": {
        "bsonType": "string",
        "description": "Discord user ID"
      },
      "reason": {
        "bsonType": "string",
        "description": "Reason for blacklisting"
      },
      "timestamp": {
        "bsonType": "date",
        "description": "When the user was blacklisted"
      },
      "modId": {
        "bsonType": "string",
        "description": "ID of the moderator who blacklisted the user"
      }
    }
  }
} 