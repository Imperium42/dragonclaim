        "bsonType": "object",
        "required": ["id"],
        "properties": {
          "id": { "bsonType": "string", "description": "Discord user ID (unique)" }
        },
        "description": "Discord /users/@me object from the portal OAuth2"
      },
      "src": { "bsonType": "object", "description": "OAuth2 source info" },
      "guildsArr": { "bsonType": "array", "description": "Guilds the user can manage" }
    }
  }
}
