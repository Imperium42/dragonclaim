{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["_id", "guildId", "eventName", "keysArr", "claimersArr"],
    "properties": {
      "_id": { "bsonType": "string", "description": "eventId: \"{guildId}-{eventName}\"" },
      "guildId": { "bsonType": "string", "description": "Discord guild ID" },
      "eventName": { "bsonType": "string", "description": "Name given in .setupgiveaway" },
      "isLive": { "bsonType": "bool" },
      "dates": { "bsonType": "object", "description": "Duration + start/end (null until displayed)" },
      "liveInChannelId": { "bsonType": ["string", "null"] },
      "embedMsgId": { "bsonType": ["string", "null"] },
      "reqsObj": { "bsonType": "object" },
      "initKeyCount": { "bsonType": ["int", "long", "double"] },
      "keysArr": { "bsonType": "array", "items": { "bsonType": "string" }, "description": "Unclaimed keys" },
      "endReason": { "bsonType": ["string", "null"] },
      "claimersArr": {
        "bsonType": "array",
        "items": {
          "bsonType": "object",
          "required": ["discordId", "claimedKey"],
          "properties": {
            "discordId": { "bsonType": "string" },
            "steamId": { "bsonType": ["string", "null"] },
            "claimedDateObj": { "bsonType": "date" },
            "claimedKey": { "bsonType": "string" }
          }
        }
      }
    }
  }
}
